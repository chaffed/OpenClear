# Copy to sandbox/.env and fill in. Keys: python scripts/generate_keys.py --output-dir sandbox/keys
PUBLIC_BASE_URL=https://sandbox.openclear.example
WEBAUTHN_RP_ID=sandbox.openclear.example
POSTGRES_PASSWORD=
SSO_ENCRYPTION_KEY=
FINERACT_DB_PASSWORD=
KEYS_DIR=./keys
OPENCLEAR_IMAGE=openclear:latest
# On an arm64 host: docker build -t openclear/moov-icl-arm64 sandbox/moov-icl && set this
MOOV_ICL_IMAGE=moov/imagecashletter:v0.17.0
# The adapter's sandbox bank (create a sandbox, then an API client in it)
ADAPTER_CLIENT_ID=
ADAPTER_CLIENT_SECRET=
